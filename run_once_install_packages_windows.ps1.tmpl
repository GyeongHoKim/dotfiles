{{- if eq .chezmoi.os "windows" }}
# Windows Package Installation Script
# This script installs development tools using winget (Windows Package Manager)
# It runs once during initial setup

$ErrorActionPreference = "Stop"

Write-Host "Starting Windows package installation..." -ForegroundColor Green

# Function to check if winget is available
function Test-WingetAvailable {
    try {
        $null = winget --version
        return $true
    }
    catch {
        return $false
    }
}

# Function to install a package with winget
function Install-WingetPackage {
    param(
        [string]$PackageId,
        [string]$Name
    )

    Write-Host "Installing $Name..." -ForegroundColor Cyan
    try {
        winget install --id $PackageId --silent --accept-package-agreements --accept-source-agreements
        Write-Host "  ✓ $Name installed successfully" -ForegroundColor Green
    }
    catch {
        Write-Host "  ✗ Failed to install $Name" -ForegroundColor Red
        Write-Host "    Error: $_" -ForegroundColor Red
    }
}

# Check if winget is available
if (-not (Test-WingetAvailable)) {
    Write-Host "Error: winget is not available. Please ensure you're running Windows 11 or install App Installer from the Microsoft Store." -ForegroundColor Red
    exit 1
}

Write-Host "winget is available. Proceeding with installation..." -ForegroundColor Green

$DotfilesProfile = "{{ .dotfiles_profile | default "desktop" }}"
Write-Host "dotfiles_profile: $DotfilesProfile" -ForegroundColor Cyan

# Shared on desktop and server (CLI / infra)
$commonPackages = @{
    "Git.Git" = "Git"
    "GitHub.cli" = "GitHub CLI"
    "vim.vim" = "Vim"
    "Neovim.Neovim" = "Neovim"
    "Microsoft.WindowsTerminal" = "Windows Terminal"
    "Microsoft.PowerShell" = "PowerShell 7+"
    "junegunn.fzf" = "fzf"
    "Docker.DockerDesktop" = "Docker Desktop"
    "Kubernetes.kubectl" = "kubectl"
    "Hashicorp.Terraform" = "Terraform"
    "Pulumi.Pulumi" = "Pulumi"
    "Helm.Helm" = "Helm"
    "GoTask.Task" = "Task"
    "GnuWin32.Make" = "GNU Make"
    "BurntSushi.ripgrep.MSVC" = "ripgrep"
    "charmbracelet.glow" = "glow"
    "sharkdp.fd" = "fd"
    "sharkdp.bat" = "bat"
    "jftuga.less" = "less (pager for bat)"
    "tmux.tmux" = "tmux"
    "ajeetdsouza.zoxide" = "zoxide"
    "JesseDuffield.lazygit" = "lazygit"
    "GnuPG.Gpg4win" = "Gpg4win (GNU GPG for Windows)"
}

# Desktop-only: GUI apps, tiling WM, VS Code, WezTerm
$desktopPackages = @{
    "Microsoft.VisualStudioCode" = "Visual Studio Code"
    "wez.wezterm" = "WezTerm"
    "glzr-io.glazewm" = "GlazeWM"
    "glzr-io.zebar" = "Zebar"
    "Brave.Brave" = "Brave Browser"
    "Obsidian.Obsidian" = "Obsidian"
    "GIMP.GIMP" = "GIMP"
    "VideoLAN.VLC" = "VLC"
    "OBSProject.OBSStudio" = "OBS Studio"
    "Insomnia.Insomnia" = "Insomnia"
}

$packages = @{}
foreach ($entry in $commonPackages.GetEnumerator()) {
    $packages[$entry.Key] = $entry.Value
}
if ($DotfilesProfile -ne "server") {
    foreach ($entry in $desktopPackages.GetEnumerator()) {
        $packages[$entry.Key] = $entry.Value
    }
}

# Install packages
$totalPackages = $packages.Count
$currentPackage = 0

foreach ($package in $packages.GetEnumerator()) {
    $currentPackage++
    Write-Host "`n[$currentPackage/$totalPackages]" -ForegroundColor Yellow
    Install-WingetPackage -PackageId $package.Key -Name $package.Value
}

# Install mise (version manager for Node, Bun, Python, Go, Rust)
Write-Host "`n" -ForegroundColor Yellow
Install-WingetPackage -PackageId "jdx.mise" -Name "mise"

# Refresh PATH in this session so the winget-installed mise binary is visible
# without needing to restart the terminal
$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + `
    [System.Environment]::GetEnvironmentVariable("Path", "User")

# Install tools declared in mise's config.toml (Node, Bun, Python, Go, Rust).
# This must run here -- if it's left as a manual step, tools tend to get
# installed standalone (e.g. via winget or a language's own installer)
# instead of being managed by mise.
Write-Host "`n--- Installing mise-managed tools (Node, Bun, Python, Go, Rust) ---" -ForegroundColor Cyan
$miseCmd = Get-Command mise -ErrorAction SilentlyContinue
if ($miseCmd) {
    $miseConfig = Join-Path $env:LOCALAPPDATA "mise\config.toml"
    if (Test-Path $miseConfig) {
        & mise install
    } else {
        Write-Host "  ! mise config.toml not found at $miseConfig, skipping mise install" -ForegroundColor Yellow
    }
} else {
    Write-Host "  ! mise command not found after installation (restart your terminal and run 'mise install' manually)" -ForegroundColor Yellow
}

# Install Mole (system cleanup CLI). It has no winget package, so use the
# official quick-install script, which git-clones the windows branch into
# %LOCALAPPDATA%\Programs\mole-cli and puts mo/mole on the user PATH.
# The script is run in a child process because it calls `exit` on failure,
# which would abort this whole script if run via `iex`.
Write-Host "`n--- Installing Mole ---" -ForegroundColor Cyan
if (Get-Command mo -ErrorAction SilentlyContinue) {
    Write-Host "  Mole already installed (use 'mo update' to upgrade)" -ForegroundColor Green
} elseif (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Host "  ! git not found, skipping Mole installation" -ForegroundColor Yellow
} else {
    $moleInstaller = Join-Path $env:TEMP "mole-quick-install.ps1"
    try {
        Invoke-WebRequest -Uri "https://raw.githubusercontent.com/tw93/Mole/windows/quick-install.ps1" -UseBasicParsing -OutFile $moleInstaller
        & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $moleInstaller
        if ($LASTEXITCODE -eq 0) {
            Write-Host "  ✓ Mole installed successfully" -ForegroundColor Green
        } else {
            Write-Host "  ✗ Mole installer exited with code $LASTEXITCODE" -ForegroundColor Red
        }
    }
    catch {
        Write-Host "  ✗ Failed to install Mole" -ForegroundColor Red
        Write-Host "    Error: $_" -ForegroundColor Red
    }
    finally {
        Remove-Item $moleInstaller -ErrorAction SilentlyContinue
    }
}

# Install Poetry if Python is available
Write-Host "`nChecking for Python and installing Poetry..." -ForegroundColor Cyan
$pythonAvailable = Get-Command py -ErrorAction SilentlyContinue

if ($pythonAvailable) {
    try {
        $poetryInstaller = (Invoke-WebRequest -Uri https://install.python-poetry.org -UseBasicParsing).Content
        $poetryInstaller | py -
        Write-Host "  ✓ Poetry installed successfully" -ForegroundColor Green
    }
    catch {
        Write-Host "  ✗ Failed to install Poetry" -ForegroundColor Red
        Write-Host "    Error: $_" -ForegroundColor Red
    }
} else {
    Write-Host "  ! Python not found, skipping Poetry installation" -ForegroundColor Yellow
}

# Install OpenSSH Server if it's not already present, then configure it to
# use PowerShell 7 as the default shell for incoming SSH sessions. Without
# the DefaultShell registry setting, sshd falls back to cmd.exe even though
# PowerShell 7 is installed, since that's a separate setting unrelated to
# what's on PATH.
Write-Host "`nChecking for OpenSSH Server..." -ForegroundColor Cyan
$sshdService = Get-Service -Name sshd -ErrorAction SilentlyContinue
if (-not $sshdService) {
    Write-Host "  OpenSSH Server not found, installing..." -ForegroundColor Cyan
    try {
        Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0 | Out-Null
        Set-Service -Name sshd -StartupType Automatic
        Start-Service sshd
        if (-not (Get-NetFirewallRule -Name "OpenSSH-Server-In-TCP" -ErrorAction SilentlyContinue)) {
            New-NetFirewallRule -Name "OpenSSH-Server-In-TCP" -DisplayName "OpenSSH Server (sshd)" -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null
        }
        $sshdService = Get-Service -Name sshd -ErrorAction SilentlyContinue
        Write-Host "  ✓ OpenSSH Server installed and started" -ForegroundColor Green
    }
    catch {
        Write-Host "  ✗ Failed to install OpenSSH Server (try running as Administrator)" -ForegroundColor Red
        Write-Host "    Error: $_" -ForegroundColor Red
    }
} else {
    Write-Host "  OpenSSH Server already installed" -ForegroundColor Green
}

if ($sshdService) {
    $pwshCmd = Get-Command pwsh -ErrorAction SilentlyContinue
    if ($pwshCmd) {
        try {
            New-ItemProperty -Path "HKLM:\SOFTWARE\OpenSSH" -Name DefaultShell -Value $pwshCmd.Source -PropertyType String -Force | Out-Null
            Write-Host "  ✓ OpenSSH default shell set to $($pwshCmd.Source)" -ForegroundColor Green
        }
        catch {
            Write-Host "  ✗ Failed to set OpenSSH default shell (try running as Administrator)" -ForegroundColor Red
            Write-Host "    Error: $_" -ForegroundColor Red
        }
    } else {
        Write-Host "  ! pwsh not found on PATH, skipping OpenSSH default shell configuration" -ForegroundColor Yellow
    }
} else {
    Write-Host "  ! OpenSSH Server unavailable, skipping default shell configuration" -ForegroundColor Yellow
}

Write-Host "`n========================================" -ForegroundColor Green
Write-Host "Package installation complete!" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Green
Write-Host ""
Write-Host "Next steps:" -ForegroundColor Yellow
Write-Host "1. Restart your terminal to load new PATH entries" -ForegroundColor White
Write-Host "2. Launch Docker Desktop to start the Docker daemon" -ForegroundColor White
Write-Host "3. Run 'mise doctor' to verify mise installation" -ForegroundColor White

Write-Host ""
{{- end }}
