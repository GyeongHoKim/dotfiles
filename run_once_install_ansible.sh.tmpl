{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -e

install_on_fedora() {
    sudo dnf install -y ansible
}

install_on_ubuntu() {
    sudo apt-get update
    sudo apt-get install -y ansible
}

install_on_debian() {
    sudo apt-get update
    sudo apt-get install -y ansible
}

install_on_mac() {
    brew install ansible
}

OS="$(uname -s)"
case "${OS}" in
    Linux*)
        if [ -f /etc/fedora-release ]; then
            install_on_fedora
        elif [ -f /etc/debian_version ]; then
            install_on_debian
        elif [ -f /etc/lsb-release ]; then
            install_on_ubuntu
        else
            echo "Unsupported Linux distribution"
            exit 1
        fi
        ;;
    Darwin*)
        install_on_mac
        ;;
    *)
        echo "Unsupported operating system: ${OS}"
        exit 1
        ;;
esac

# Ansible's sudo become plugin matches the prompt it passes via -p against the
# start of each output line. sudo-rs wraps it as "[sudo: <prompt>] Password:",
# so the match never succeeds and every become task fails with
# "Timed out waiting for become success or become password prompt".
# See https://bugs.launchpad.net/ubuntu/+source/ansible/+bug/2122414
# Ubuntu 25.10+ ships sudo-rs at a higher alternatives priority than the
# traditional sudo, so pin sudo.ws in manual mode when it is available.
switch_off_sudo_rs() {
    if ! sudo -V 2>/dev/null | head -1 | grep -qi 'sudo-rs'; then
        return 0
    fi

    if ! command -v update-alternatives >/dev/null 2>&1 ||
        ! update-alternatives --list sudo 2>/dev/null | grep -qx '/usr/bin/sudo.ws'; then
        echo "WARNING: sudo-rs is the default sudo and /usr/bin/sudo.ws is unavailable." >&2
        echo "WARNING: Ansible become tasks will time out. Install the 'sudo' package first." >&2
        return 0
    fi

    echo "Detected sudo-rs; switching the sudo alternative to /usr/bin/sudo.ws for Ansible compatibility."
    sudo update-alternatives --set sudo /usr/bin/sudo.ws
}

# Install required Ansible collections
ansible-galaxy collection install community.general

if [ "${OS}" != "Darwin" ]; then
    switch_off_sudo_rs
fi

BECOME_FLAG=""
if [ -t 0 ]; then
    BECOME_FLAG="--ask-become-pass"
fi

ansible-playbook ~/.bootstrap/setup.yml -e dotfiles_profile={{ .dotfiles_profile | default "desktop" }} $BECOME_FLAG

echo "Ansible installation complete."

{{- end -}}
