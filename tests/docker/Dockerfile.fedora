# CI: server profile only (`dotfiles_profile=server`). See entrypoint-linux-server.sh.
FROM fedora:latest

RUN dnf install -y \
    curl \
    git \
    sudo \
    which \
    && dnf clean all

RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER testuser
WORKDIR /home/testuser

ENV HOME=/home/testuser
ENV USER=testuser

COPY --chown=testuser:testuser . /home/testuser/dotfiles
COPY --chown=testuser:testuser tests/collect_debug.sh /home/testuser/collect_debug.sh
COPY --chown=testuser:testuser tests/docker/entrypoint-linux-server.sh /home/testuser/entrypoint-linux-server.sh
RUN chmod +x /home/testuser/collect_debug.sh /home/testuser/entrypoint-linux-server.sh

CMD ["/home/testuser/entrypoint-linux-server.sh"]
